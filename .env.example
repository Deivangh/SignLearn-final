# --- Required ---------------------------------------------------------
# Your data.gov.in key. Get one free at https://data.gov.in/user/register
DATAGOV_API_KEY=paste_your_key_here

# --- Recommended ------------------------------------------------------
# Google Cloud API key with the Drive API enabled. Makes dictionary indexing
# reliable. Without it SignBridge falls back to Drive's public folder view.
GOOGLE_API_KEY=

# --- Windows only -----------------------------------------------------
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Optional ---------------------------------------------------------
OCR_LANGS=eng
ENABLE_SCENE_ILLUSTRATION=0
GEMINI_API_KEY=
